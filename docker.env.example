# Copy to .env next to compose.yaml and edit (docs/DOCKER.md). No secrets here.

# Folder on this computer that holds the photo library (must exist).
#   Mac:   /Volumes/<external disk>/WithAlbum
#   Linux: /mnt/<disk>/WithAlbum   (owned by uid 10001: sudo chown -R 10001:10001 <folder>)
WITHALBUM_DATA=/Volumes/PhotoDisk/WithAlbum

# This computer's address on the home network, as phones see it, with the port below.
WITHALBUM_LAN_URL=https://192.168.0.10:8787
WITHALBUM_LAN_PORT=8787
# Publish on one address only (default: all of this computer's addresses).
# WITHALBUM_LAN_BIND=192.168.0.10

# Optional: Tailscale Funnel address (docs/FUNNEL.md, "Docker" section). Empty = off.
WITHALBUM_FUNNEL_URL=

# Optional: pin the volume printed by -init-storage.
# WITHALBUM_VOLUME_ID=

# Sign in with Google (M62): the server has the WithAlbum app's public client IDs
# built in and reads the keys from the "keys" container. Only set this to use
# your own app build's IDs, or "off" to turn Google sign-in off.
# WITHALBUM_GOOGLE_CLIENT_IDS=off

TZ=Asia/Seoul
# WITHALBUM_MEMORY=2g
