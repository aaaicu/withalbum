# FOR LOCAL DEVELOPMENT ONLY; DO NOT EXPOSE TO THE NETWORK.
WITHALBUM_ROOT=./withalbum-data
WITHALBUM_LISTEN=127.0.0.1:8787
# Optional: pin the volume printed by `withalbum-server -init-storage`.
# WITHALBUM_VOLUME_ID=
# Optional: free space (bytes) an upload must leave on the volume; below it
# uploads get 507 insufficient_storage. Default 1073741824 (1 GiB).
# WITHALBUM_MIN_FREE_BYTES=1073741824
# Optional external preview tools (HEIC and other stills: macOS sips; videos:
# ffmpeg). Found on PATH and in /usr/bin, /opt/homebrew/bin, /usr/local/bin;
# without them those originals are stored with preview_status "unsupported".
# "off" disables one tool; an absolute path selects a specific executable.
# WITHALBUM_PREVIEW_TOOLS=off
# WITHALBUM_SIPS=/usr/bin/sips
# WITHALBUM_FFMPEG=/opt/homebrew/bin/ffmpeg
